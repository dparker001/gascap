generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String    @id
  email                    String    @unique
  name                     String
  passwordHash             String?   // null for Google OAuth users
  plan                     String    @default("free")
  createdAt                String
  stripeCustomerId         String?
  stripeSubscriptionId     String?   @unique
  calcCount                Int       @default(0)
  budgetCalcCount          Int       @default(0)
  locationLookups          Int       @default(0)
  activeDays               String[]  @default([])
  streak                   Int       @default(0)
  badges                   String[]  @default([])
  referralCode             String?   @unique
  referredBy               String?
  referralCount            Int       @default(0)
  referralProMonthsEarned  Int       @default(0)
  referralRewardCredited   Boolean   @default(false)
  referralCredits          Json      @default("[]")
  isProTrial               Boolean   @default(false)
  trialExpiresAt           String?
  emailVerified            Boolean   @default(false)
  emailVerifyToken         String?
  emailVerifyExpires       String?
  passwordResetToken       String?
  passwordResetExpires     String?
  phone                    String?
  displayName              String?
  priceAlertThreshold      Float?
  lastPriceAlertSentAt     String?
  // True once we've alerted for the current below-threshold drop; reset when the
  // price goes back above the threshold. Drives one-alert-per-drop (not daily).
  priceAlertNotified       Boolean   @default(false)
  loginCount               Int       @default(0)
  lastLoginAt              String?
  fillupReminderDays       Int?
  lastFillupReminderSentAt String?
  streakMilestonesHit      Int[]     @default([])
  streakCredits            Json      @default("[]")
  locale                   String?
  emailCampaignStep        Int?
  emailCampaignEnrolledAt  String?
  emailOptOut              Boolean   @default(false)
  isTestAccount            Boolean   @default(false)
  fleetDrivers             String[]  @default([])
  paidCampaignEnrolledAt   String?
  paidCampaignStep         Int?
  stripeInterval           String?
  foundingMemberAt         DateTime?
  verifyReminderSentAt           String?
  verifyReminderBonusEntries     Int       @default(0)
  ambassadorProForLife     Boolean   @default(false)
  // Sprint 2 hardening — server-authorized admin access. Never trust a client-
  // supplied role; always resolve this column live from the DB (see
  // lib/adminAuth.ts). 'user' | 'admin'. No 'support' tier yet — nothing in
  // the product needs a read-only admin role today; add one later without a
  // migration if that changes, since this is a plain string, not an enum.
  role                     String    @default("user")
  // Sprint 2 hardening — RevenueCat's contribution to this user's Pro access,
  // tracked independently of Stripe/gifted/Ambassador so a RevenueCat-side
  // EXPIRATION/REFUND can never wipe a DIFFERENT provider's legitimate grant.
  // See lib/entitlements.ts. Defaults preserve current behavior for every
  // existing user — nothing here is backfilled from history because no
  // history was recorded before this shipped (see RevenueCatWebhookEvent).
  revenueCatActive         Boolean   @default(false)
  revenueCatInterval       String?   // 'monthly' | 'lifetime'
  revenueCatProductId      String?
  // Which Ambassador tiers ('supporter'|'ambassador'|'elite') have already had their
  // one-time Marketing Boost voucher reward sent — prevents duplicate sends on
  // Stripe webhook retries. See app/api/stripe/webhook/route.ts referral-credit block.
  ambassadorTierRewardsSent String[] @default([])
  compCampaignEnrolledAt   String?
  compCampaignStep         Int?
  smsOptIn                 Boolean   @default(false)
  engagementEnrolledAt     String?
  engagementStep           Int?
  engagementTrack          String?
  milestoneFillup10Sent    Boolean   @default(false)
  milestoneMpgSent         Boolean   @default(false)
  milestoneReferral1Sent   Boolean   @default(false)
  earlyUpgradeBonusEntries Int       @default(0)
  phoneBonusEntries        Int       @default(0)
  /// ISO string, set when a phone OTP is successfully confirmed. Distinct from
  /// `phone` (merely stored) and from smsOptIn (a marketing preference).
  phoneVerifiedAt          String?
  firstCalcBonusEntries    Int       @default(0)   // +entries granted on a user's first calculation (activation reward)
  emailVerifyBonusGranted  Boolean   @default(false)
  smsOptInDate             String?
  avatarUrl                String?
  preferredFillLevel       Int?     // % 0-100 — default target fill for calculators
  monthlyFuelBudget        Float?   // $ amount — monthly spending target
  garageBonusDays          String[]  @default([])
  garageLastOpenedDate     String?
  fleetCompanyName         String?
  fleetLogoUrl             String?
  // Daily bonus gift box — awarded once per calendar day (3–15 entries, random)
  dailyBonusDays           String[]  @default([])   // YYYY-MM-DD dates claimed (idempotency)
  dailyBonusEntries        Int       @default(0)     // running total across all time
  // Native iOS push (Capacitor) — APNs device token + last-updated timestamp
  iosPushToken             String?
  iosPushTokenAt           String?
  // Win-back ("come back to Pro") campaign for lapsed free users (expired trial).
  // winbackStep: 0 = not started, 1–3 = last email sent in the 3-step sequence.
  winbackStep              Int       @default(0)
  winbackLastSentAt        String?
  winbackStartedAt         String?   // when the win-back sequence began (drives the 3-day offer deadline)
  // Lifetime Perks add-on — annual $9.99 renewal granting +20 giveaway entries + vacation voucher.
  // Null = never subscribed or lapsed. Kept separate from stripeSubscriptionId (that slot is used
  // by the primary Pro Lifetime one-time payment or monthly/annual sub).
  lifetimePerksUntil       DateTime?
  lifetimePerksSubId       String?
  // Getaway activation tracking — added because there was none at all. The
  // /getaway/choose route was "intentionally DB-less" (only fired emails), so
  // GasCap had no way to know who'd chosen a destination, let alone who'd
  // actually paid the destination taxes/fees on Marketing Boost's site (that
  // step happens entirely off-platform — MB may track it, GasCap doesn't).
  // lifetimePurchasedAt only backfills going forward (set at purchase time);
  // existing Lifetime members before this shipped will have it null and are
  // excluded from the reminder cron rather than guessed at.
  lifetimePurchasedAt      String?
  getawayDestinationId     String?
  getawayDestinationChosenAt String?
  getawayReminderSentAt    String?
  /// Post-Sprint-2 Revision 1 fix — durable one-time marker so a crash
  /// between sending this email and marking the triggering webhook event
  /// processed can't cause a retry to send it twice. Claimed atomically
  /// (updateMany WHERE this is null) immediately before sending, by both
  /// the RevenueCat and Stripe getaway-choose email paths. See
  /// app/api/native/revenuecat/route.ts's maybeSendGetaway().
  getawayChooseEmailSentAt String?
  // OTP passwordless sign-in — one-time session token issued after code verification,
  // consumed by the credentials-otp NextAuth provider (2-min TTL).
  otpSessionToken          String?
  otpSessionExpires        String?
  otpCode                  String?
  otpCodeExpires           String?
  otpCodeName              String?
  priceReportEntries       Int       @default(0)
  gigLogEntries            Int       @default(0)
  // Streak milestone bonus for Lifetime members — a free-month StreakCredit
  // is meaningless for them (no subscription to apply it to), so they earn
  // giveaway entries instead, awarded in the same tier ladder as the
  // referral program (10/20/30/50 by milestone). See awardStreakMilestones().
  streakMilestoneBonusEntries Int    @default(0)
  // Same idea as streakMilestoneBonusEntries, for the Ambassador Supporter
  // tier's free-month credit — meaningless for Lifetime members below the
  // Ambassador threshold, so they earn giveaway entries instead (10/referral,
  // same rate as the 30-day streak substitute). See recordReferral().
  referralLifetimeBonusEntries Int   @default(0)
  signupPlatform           String?   // 'web' | 'ios' | 'android' — WHERE THEY FIRST SIGNED UP, never updated after
  // Set on every native app visit (NativeAppShell), separate from signupPlatform —
  // this is how a web signup who later downloads the app becomes visible to admin.
  // See gotcha-native-signup-vs-usage-platform memory.
  lastNativePlatform       String?   // 'ios' | 'android' | null
  lastNativeAt             String?
  userMode                 String?   // 'personal' | 'gig' | 'rental' | 'fleet'
  // Stamped when the "log your first fill-up" nudge is sent, so it only ever
  // goes out once per user. See app/api/cron/first-fillup-nudge.
  firstFillupNudgedAt      String?
  vehicles                 Vehicle[]
  priceReports             PriceReport[]
  gigFillups               GigFillup[]
  gigMileage               GigMileage[]
  favoriteStations         FavoriteStation[]
  deviceSessions           DeviceSession[]
  rentalSessions           RentalSession[]
}

model OtpCode {
  email   String   @id
  code    String
  name    String   @default("")
  expires DateTime
}

/// Sprint 2 hardening — RevenueCat delivers webhooks at-least-once, so the
/// same event.id can arrive more than once. This is the dedup key AND the
/// durable record of "did we actually process this," so a crash between
/// receiving an event and finishing its side effects is safely retryable
/// instead of either silently repeating a grant or silently losing one.
/// Sprint 2 hardening — Postgres-backed rate limiting, replacing the
/// in-memory Map for security-sensitive flows. The in-memory version resets
/// on every deploy and doesn't share state across instances if GasCap ever
/// scales horizontally; both are silent correctness gaps rather than crashes,
/// which is exactly the kind of bug that goes unnoticed. Key is caller-defined
/// (e.g. "otp-verify:user@example.com", "pwreset:1.2.3.4") — same convention
/// as the in-memory checkRateLimit() it complements, not replaces (see
/// lib/rateLimitDb.ts and docs/RATE_LIMITING_PLAN.md for which is used where).
model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  /// Post-Sprint-2 Revision 1: real Postgres timestamp, not a String — this
  /// table had not been deployed to production yet, so changing the type
  /// carries no migration-data risk. A window end; a fresh window is
  /// started when now > resetAt. See lib/rateLimitDb.ts for the atomic
  /// single-statement INSERT ... ON CONFLICT this drives.
  resetAt   DateTime

  @@index([resetAt])
}

model RevenueCatWebhookEvent {
  id          String   @id   // RevenueCat's own event.id — the dedup key, not our own uuid
  eventType   String
  userId      String?
  /// received: row exists, nothing done yet.
  /// processing: claimed by a request in flight — lets a retry tell "still
  ///   working" apart from "crashed mid-flight," see lib/revenueCatEvents.ts.
  /// processed: side effects completed successfully.
  /// failed: attempted and errored; safe to retry, not permanently stuck.
  status      String   @default("received")
  /// Post-Sprint-2 Revision 1 fix. Assigned fresh on every successful claim
  /// (initial or reclaim) and required to match on markProcessed/markFailed —
  /// this is the compare-and-swap ownership token that makes concurrent
  /// reclaim of a failed/stale-processing row safe. An old claimant whose
  /// token no longer matches (because a newer claimant already reclaimed the
  /// row) cannot overwrite that newer claimant's state. See
  /// lib/revenueCatEvents.ts.
  claimToken  String?
  receivedAt  String
  processedAt String?
  error       String?

  @@index([userId])
}

/// Sprint 2 hardening — who did what, for the highest-risk admin mutations
/// (plan changes, giveaway/draw actions, deletions). Never stores secrets or
/// full payloads — metadata is for context like "which user" or "which
/// draw month," not request bodies.
model AdminAuditLog {
  id          String   @id
  actorUserId String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  success     Boolean
  createdAt   String

  @@index([actorUserId])
  @@index([createdAt])
}

/// Sprint 2 hardening — AMOE (Alternative Method of Entry, "No Purchase
/// Necessary") free sweepstakes entries, migrated off data/amoe-entries.json.
/// One entry per person per Entry Month, enforced here at the database level
/// via the unique constraint rather than only in application code.
model AmoeEntry {
  id          String   @id
  firstName   String
  lastName    String
  email       String
  month       String   // YYYY-MM
  submittedAt String

  @@unique([email, month])
  @@index([month])
}

model Vehicle {
  id              String  @id
  userId          String
  name            String
  gallons         Float
  vin             String?
  year            String?
  make            String?
  model           String?
  trim            String?
  fuelType        String?
  fuelTypeConfirmedByUser Boolean @default(false)
  epaId           String?
  currentOdometer   Float?
  vehicleSpecs      Json?
  isDefault         Boolean @default(false)
  createdAt         String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Fillup {
  id              String  @id
  userId          String
  vehicleId       String?
  vehicleName     String
  date            String   // YYYY-MM-DD
  gallonsPumped   Float
  pricePerGallon  Float
  totalCost       Float
  odometerReading Float?
  fuelLevelBefore Float?
  stationName     String?
  notes           String?
  driverLabel     String?
  fuelGrade       String?  // "regular" | "midgrade" | "premium" | "diesel" | "e85"
  receiptThumb    String?  // base64-compressed JPEG thumbnail of receipt (data URL)
  createdAt       String

  @@index([userId])
  @@index([userId, date])
}

model GigFillup {
  id             String  @id
  userId         String
  date           String   // YYYY-MM-DD
  // gallons/pricePerGallon hold the QUANTITY and UNIT PRICE for whichever
  // energy the vehicle takes — gallons at $/gal, or kWh at $/kWh for an EV.
  // energyUnit says which, so summaries and the tax CSV can label them
  // correctly. Column names are historical; renaming them would break every
  // existing caller for no functional gain. Cost per mile is unaffected —
  // it's totalCost ÷ miles, which is unit-agnostic.
  gallons        Float
  pricePerGallon Float
  energyUnit     String  @default("gal")  // "gal" | "kwh"
  totalCost      Float
  station        String?
  odometer       Float?
  platform       String?  // "uber" | "lyft" | "doordash" | "instacart" | "spark" | "amazon_flex" | "shipt" | "courier" | "other"
  notes          String?
  createdAt      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model GigMileage {
  id            String  @id
  userId        String
  date          String   // YYYY-MM-DD
  startOdometer Float?
  endOdometer   Float?
  miles         Float
  platform      String?  // same enum as GigFillup.platform
  category      String   @default("business") // "business" | "personal"
  notes         String?
  createdAt     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model EmailLog {
  id        String  @id
  userId    String
  userEmail String
  userName  String
  type      String
  subject   String
  sentAt    String
  error     String?
  status    String  @default("sent")

  @@index([userId])
  @@index([sentAt])
  @@index([type])
  @@index([status])
}

model GiveawayDraw {
  id             String  @id
  month          String  @unique
  winnerId       String
  winnerName     String
  winnerEmail    String
  entryCount     Int
  totalEntries   Int
  drawnAt        String
  notes          String?
  claimedAt      String?  // set when winner confirms receipt; null = unclaimed
  claimToken     String?  // unique token embedded in the winner's claim link (self-serve confirmation)
  ageConfirmedAt String?  // set when the winner (or admin, as manual override) certifies 18+ eligibility
}

model CampaignPlacement {
  id              String  @id
  code            String  @unique
  campaign        String
  station         String  @default("")
  address         String?
  city            String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  placement       String
  headlineVariant String
  landingPath     String
  notes           String?
  createdAt       String
  active          Boolean @default(true)
  featured        Boolean @default(false)

  @@index([code])
}

model DeletedAccountLog {
  id          String  @id
  // Snapshot of user info captured before deletion
  userId      String
  name        String
  email       String
  plan        String
  // Metadata
  deletedAt   String
  reason      String? // "user_request" | "admin_action" | "violation" etc.
  notes       String? // optional free-text from admin
  // Was a confirmation email sent?
  emailSent   Boolean @default(false)

  @@index([email])
  @@index([deletedAt])
}

model Gift {
  id                 String  @id            // gift_xxxxxxxx
  code               String  @unique        // redemption code, e.g. GASCAP-7K2P-9QX4
  occasion           String  @default("gift") // gift | fathers-day | birthday | holiday
  plan               String  @default("pro")
  interval           String  @default("lifetime")
  amountPaid         Int                    // cents actually charged
  purchaserEmail     String
  purchaserUserId    String?
  recipientEmail     String?                // null = buyer keeps the code
  recipientName      String?
  giftMessage        String?
  deliverToRecipient Boolean @default(false)
  stripeSessionId    String?
  stripePaymentId    String?
  status             String  @default("paid") // paid | redeemed | refunded
  redeemedByUserId   String?
  redeemedAt         String?
  createdAt          String

  @@index([code])
  @@index([purchaserEmail])
  @@index([status])
}

// User-submitted testimonials. One per user (keyed by userId, upsert on edit).
// New reviews default approved=false → moderated at /admin/reviews before going public.
model Review {
  id          String  @id
  userId      String  @unique
  userName    String
  rating      Int
  text        String
  vehicleName String?
  plan        String  @default("free")
  lifetime    Boolean @default(false)
  approved    Boolean @default(false)
  createdAt   String
  updatedAt   String

  @@index([approved])
}

// Gauge scan results stored for QA and future model improvement.
// Additive-only: no existing models touched.
model GaugeScanLog {
  id               String  @id @default(cuid())
  userId           String
  detectedPercent  Int?
  confirmedPercent Int
  confidence       Int
  gaugeType        String
  reason           String?
  vehicleId        String?
  vehicleName      String?
  tankSize         Float?
  createdAt        String

  @@index([userId])
  @@index([createdAt])
}

model PriceReport {
  id          String  @id
  userId      String
  placeId     String
  stationName String
  lat         Float
  lng         Float
  grade       String
  price       Float
  createdAt   String

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([placeId])
  @@index([createdAt])
}

// A saved gas station. Shows on the Find Gas tab regardless of search state
// (including before any search has run) with the LAST-KNOWN price snapshot,
// not a live re-fetch — cheap, no extra Google Places calls on every tab
// open. `prices`/`priceUpdatedAt` are refreshed opportunistically whenever
// the station shows up again in a live nearby-stations result.
model FavoriteStation {
  id             String  @id
  userId         String
  placeId        String
  name           String
  address        String
  lat            Float
  lng            Float
  prices         Json    // FuelPrice[] snapshot — see lib/nearbyGas.ts
  priceUpdatedAt String? // when the snapshot above was captured
  createdAt      String

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
}

// One row per distinct device/browser touching an account (a persistent
// per-install id, not a login event) — used only for the soft "this account
// looks shared" signal, never to block or evict anyone. See
// lib/deviceSessions.ts for the active-device-count query this backs.
model DeviceSession {
  id           String  @id
  userId       String
  deviceId     String  // random UUID persisted client-side (localStorage / native storage)
  platform     String  // 'web' | 'ios' | 'android'
  firstSeenAt  String
  lastSeenAt   String

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

// GasCap™ Rental Return Assistant — Level 1.
//
// A persisted rental session, distinct from the calculator's ephemeral
// Rental Car Return Mode (which never saves anything — it's just
// localStorage state for a single in-progress calculation). This model is
// provider-independent by design: every fuel-level field is populated today
// by ManualRentalDataProvider (see lib/rentalProvider.ts), but the shape is
// meant to also accept authoritative data from a future rental-company API
// or vehicle telematics feed without changing the UI or calculation engine
// that consume it. See docs/RENTAL_INTEGRATION_LEVEL2.md.
//
// `pickupFuelSource` / `currentFuelSource` hold a FuelDataSource value
// (MANUAL_GAUGE | MANUAL_PERCENT | MANUAL_GALLONS | RECEIPT |
// RENTAL_COMPANY_API | VEHICLE_TELEMATICS) — the confidence/precision of
// that specific reading, independent of `provider`, which identifies which
// RentalDataProvider populated the session as a whole.
model RentalSession {
  id                          String   @id
  userId                      String
  vehicleId                   String?  // optional link to an existing garage Vehicle

  provider                    String   @default("manual") // RentalDataProvider id — 'manual' for all of Level 1
  status                      String   @default("active")  // 'active' | 'completed' | 'cancelled'

  rentalCompany                String
  // Companies differ on which identifier they print: Hertz uses a
  // confirmation number, Avis issues both. Store them separately rather
  // than forcing one field to mean either.
  rentalAgreementNumber        String?
  rentalConfirmationNumber     String?

  vehicleYear                  String?
  vehicleMake                  String?
  vehicleModel                 String?
  vehicleTrim                  String?
  fuelTankCapacityGallons      Float?

  pickupFuelGallons             Float?
  pickupFuelSource              String? // FuelDataSource
  requiredReturnFuelGallons     Float?
  requiredReturnPolicyType      String? // 'same_as_pickup' | 'full' | 'exact' — see lib/rentalCalculations.ts
  currentFuelGallons            Float?
  currentFuelSource             String? // FuelDataSource
  currentFuelUpdatedAt          String?

  rentalFuelChargePerGallon     Float?

  pickupDateTime                String?
  returnDateTime                String?
  pickupLocation                String?
  returnLocation                 String?
  returnLatitude                  Float?
  returnLongitude                 Float?

  // Photos — same compressed-base64-thumbnail pattern as Fillup.receiptThumb,
  // no new storage infra. All optional and purely for the renter's own
  // documentation; never presented as legal proof of fuel level.
  pickupVehiclePhotoThumb        String?
  pickupGaugePhotoThumb           String?
  pickupAgreementPhotoThumb        String?
  returnGaugePhotoThumb             String?
  returnReceiptPhotoThumb            String?

  // Each "I Just Refueled" log entry as one array item — see
  // RefuelLogEntry in lib/rentalProvider.ts for the shape.
  refuelLogs                   Json     @default("[]")

  // Post-completion fuel-dispute tracking (section 24 of the pilot spec) —
  // the whole point of the pilot is measuring whether GasCap reduces this.
  fuelFeeCharged                Boolean?
  fuelFeeAmount                  Float?
  fuelFeeGallonsClaimed           Float?
  fuelFeeRentalReportedLevel       Float?
  disputeNotes                      String?

  feedbackRating                Int?    // 1–5, optional
  feedbackText                   String?

  notes                        String?
  reminderSentAt                 String? // dedup guard: return-fuel reminder
  pickupReminder24SentAt         String? // dedup guard: 24h-before-pickup reminder
  pickupReminder2SentAt          String? // dedup guard: 2h-before-pickup reminder
  completedAt                   String?
  createdAt                    String
  updatedAt                    String

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}
